-- ══════════════════════════════════════
--  BARBER WORK DAYS (per-date configs)
-- ══════════════════════════════════════
CREATE TABLE public.barber_work_days (
  id SERIAL PRIMARY KEY,
  barber_id INT NOT NULL REFERENCES public.barbers(id) ON DELETE CASCADE,
  work_date DATE NOT NULL,
  active BOOLEAN NOT NULL DEFAULT TRUE,
  start_time TEXT NOT NULL DEFAULT '12:00',
  end_time TEXT NOT NULL DEFAULT '20:00',
  duration INT, -- per-day override, NULL = use barber.global_duration
  breaks JSONB NOT NULL DEFAULT '[]', -- [{"start":"15:00","end":"15:30"}]
  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE(barber_id, work_date)
);


-- ══════════════════════════════════════
--  BARBER TIME OFF
-- ══════════════════════════════════════
CREATE TABLE public.barber_time_off (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  barber_id INT NOT NULL REFERENCES public.barbers(id) ON DELETE CASCADE,
  start_date DATE NOT NULL,
  end_date DATE NOT NULL,
  reason TEXT NOT NULL DEFAULT 'ostalo' CHECK (reason IN ('godisnji_odmor', 'bolovanje', 'ostalo')),
  note TEXT,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);


-- ══════════════════════════════════════
--  SHOP CLOSURES
-- ══════════════════════════════════════
CREATE TABLE public.shop_closures (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  closure_date DATE NOT NULL UNIQUE,
  reason TEXT NOT NULL,
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);


-- ══════════════════════════════════════
--  APPOINTMENTS
-- ══════════════════════════════════════
CREATE TABLE public.appointments (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  barber_id INT NOT NULL REFERENCES public.barbers(id) ON DELETE CASCADE,
  barber_name TEXT NOT NULL,
  user_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
  appointment_date DATE NOT NULL,
  appointment_time TEXT NOT NULL,
  services TEXT[] NOT NULL DEFAULT '{}',
  total_price DECIMAL(10,2) NOT NULL DEFAULT 0,
  user_name TEXT NOT NULL DEFAULT '',
  user_email TEXT NOT NULL DEFAULT '',
  user_phone TEXT NOT NULL DEFAULT '',
  status TEXT NOT NULL DEFAULT 'confirmed' CHECK (status IN ('confirmed', 'cancelled')),
  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Index for fast slot lookups
CREATE INDEX idx_appointments_lookup
  ON public.appointments(barber_name, appointment_date, status);


